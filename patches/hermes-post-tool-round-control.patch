+def _summarize_round_for_control(*, assistant_message: Any, messages: Any):
+    """Build abbreviated tool_calls / tool_results / statuses for post_tool_round_control."""
+    import json as _json
+    calls: list = []
+    results: list = []
+    statuses: list = []
+    errors: list = []
+    mutated = False
+    _MUTATING = frozenset({
+        "write_file", "patch", "terminal", "execute_code", "delete_file", "move_file",
+        "run_terminal_cmd", "bash", "shell",
+    })
+    tool_calls = getattr(assistant_message, "tool_calls", None) or []
+    for tc in tool_calls:
+        name = getattr(getattr(tc, "function", None), "name", "") or ""
+        raw_args = getattr(getattr(tc, "function", None), "arguments", "") or ""
+        if name in _MUTATING:
+            mutated = True
+        args_preview = raw_args if isinstance(raw_args, str) else _json.dumps(raw_args, default=str)
+        calls.append({"name": name, "args": _abbreviate_text(args_preview, 300)})
+    # Walk trailing tool messages for this round
+    for msg in reversed(list(messages or [])):
+        if not isinstance(msg, dict):
+            continue
+        if msg.get("role") == "assistant" and msg.get("tool_calls"):
+            break
+        if msg.get("role") != "tool":
+            continue
+        content = msg.get("content") or ""
+        content_s = content if isinstance(content, str) else str(content)
+        low = content_s.lower()
+        status = "error" if any(t in low for t in ("error", "traceback", "exception", "failed", "fatal")) else "ok"
+        statuses.append(status)
+        entry = {
+            "name": msg.get("name") or "",
+            "tool_call_id": msg.get("tool_call_id") or "",
+            "content": _abbreviate_text(content_s, 800),
+            "status": status,
+        }
+        results.append(entry)
+        if status == "error":
+            errors.append({"name": entry["name"], "snippet": _abbreviate_text(content_s, 200)})
+    results.reverse()
+    statuses.reverse()
+    errors.reverse()
+    return calls, results, statuses, errors, mutated
+
