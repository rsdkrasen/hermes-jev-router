+def get_post_tool_round_control(
+    *,
+    session_id: str = "",
+    task_id: str = "",
+    turn_id: str = "",
+    user_goal: str = "",
+    tool_calls: Optional[List[Dict[str, Any]]] = None,
+    tool_results: Optional[List[Dict[str, Any]]] = None,
+    statuses: Optional[List[str]] = None,
+    errors: Optional[List[Dict[str, Any]]] = None,
+    mutated: bool = False,
+    verification: Optional[Dict[str, Any]] = None,
+    api_call_count: int = 0,
+    **extra: Any,
+) -> Optional[Dict[str, Any]]:
+    """Consult ``post_tool_round_control`` hooks after a tool round completes.
+
+    Return contract (first ``finish`` wins):
+      * ``None`` / ``{"action": "continue"}`` → caller continues to the next provider API call
+      * ``{"action": "finish", "message": "..."}`` → caller sets ``final_response`` and breaks
+        into ``finalize_turn`` (normal persistence/cleanup — do not bypass)
+
+    Fail-open: exceptions and unrecognized returns are treated as continue.
+    """
+    try:
+        hook_results = invoke_hook(
+            "post_tool_round_control",
+            session_id=session_id,
+            task_id=task_id,
+            turn_id=turn_id,
+            user_goal=user_goal,
+            tool_calls=list(tool_calls or []),
+            tool_results=list(tool_results or []),
+            statuses=list(statuses or []),
+            errors=list(errors or []),
+            mutated=bool(mutated),
+            verification=dict(verification or {}),
+            api_call_count=int(api_call_count or 0),
+            **extra,
+        )
+    except Exception:
+        logger.debug("post_tool_round_control invoke failed open", exc_info=True)
+        return None
+    for result in hook_results:
+        if not isinstance(result, dict):
+            continue
+        action = str(result.get("action") or "").strip().lower()
+        if action == "finish":
+            message = result.get("message")
+            if isinstance(message, str) and message.strip():
+                return {"action": "finish", "message": message.strip()}
+        # continue / empty / other → keep scanning; ultimately None = continue
+    return None
+
